# 飞鸽AI客服环境变量配置示例
# 复制为 .env 并填写真实值
# 详见 docs/20-配置规范.md §20.4.3

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书机器人告警（可选）
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your-hook-id
FEISHU_SECRET=your-signing-secret

# 短信告警（可选，仅 critical 级别）
SMS_ACCESS_KEY=your-aliyun-access-key
SMS_ACCESS_SECRET=your-aliyun-access-secret
DUTY_PHONE_1=13800138000
DUTY_PHONE_2=13900139000
